# Copy to .env and fill in. .env is gitignored.

# Required for Modo Real (src/extraction/openrouter_client.py).
OPENROUTER_API_KEY=
# Must support response_format/structured_outputs (the client sends
# provider.require_parameters=true). Temperature is fixed at 0 in the client.
# Select a provider model compatible with strict structured outputs.
OPENROUTER_MODEL=

# Optional
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_SECONDS=
# Total wall-clock budget for one generation, including transport retries.
# OPENROUTER_TOTAL_DEADLINE_SECONDS=90
# OPENROUTER_MAX_RETRIES=

# SEC EDGAR identity for edgartools ("Name email@example.com")
# EDGAR_IDENTITY=

# Audio (src/audio)
# GROQ_API_KEY=
# KOKORO_MODEL_DIR=

# Streamlit -> FastAPI
# API_URL=http://localhost:8000

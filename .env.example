# Copy to .env and fill in. .env is gitignored.

# Required for Modo Real (src/extraction/openrouter_client.py).
OPENROUTER_API_KEY=
# Must support response_format/structured_outputs (the client sends
# provider.require_parameters=true). Temperature is fixed at 0 in the client.
# Recommended for verbatim evidence extraction:
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Optional
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_SECONDS=
# OPENROUTER_MAX_RETRIES=

# SEC EDGAR identity for edgartools ("Name email@example.com")
# EDGAR_IDENTITY=

# Audio (src/audio)
# GROQ_API_KEY=
# KOKORO_MODEL_DIR=

# Streamlit -> FastAPI
# API_URL=http://localhost:8000

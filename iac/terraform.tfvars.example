# Copia este fichero a terraform.tfvars y ajusta los valores.
# terraform.tfvars está en .gitignore (nunca lo subas si trae datos reales).

gcp_project_id     = "ml-miax"
gcp_project_sys_id = "ml-miax"
region_name        = "europe-southwest1"
base_name          = "fintech-mvp"
openrouter_model   = "anthropic/claude-sonnet-4.5"
repo_iac_url       = "fintech-multimodal-mvp"
github_repository  = "marcocorpacriado-pixel/fintech-multimodal-mvp"
idle_timeout_seconds = 300 # 900 = 15 min; 0 desactiva la pausa por inactividad
idle_warning_seconds = 30
